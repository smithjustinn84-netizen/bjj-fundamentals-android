<!-- The forms that create and edit a concept, a position or a technique. -->
<resources>
    <!-- The way out of "… not found", when the item being edited is gone. -->
    <string name="editor_back">Back</string>

    <!-- Page titles. -->
    <string name="editor_edit_concept">Edit concept</string>
    <string name="editor_edit_position">Edit position</string>
