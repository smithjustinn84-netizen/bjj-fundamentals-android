    <string name="editor_delete_concept_title">Delete concept?</string>
    <string name="editor_delete_position_title">Delete position?</string>
    <string name="editor_delete_technique_title">Delete technique?</string>
    <!-- %1$s is the item's name. -->
    <string name="editor_delete_text">Delete "%1$s"?</string>
